generator client {
  provider = "prisma-client-js"
  // Generate outside src/ so the compiled dist/client.js can require
  // ../generated/prisma without relying on tsc to copy Prisma engine assets.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                              String                           @id @default(uuid())
  name                            String
  slug                            String                           @unique
  domain                          String?                          @unique
  theme                           String                           @default("default")
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  users                           TenantUser[]
  feedbacks                       Feedback[]
  followUps                       FollowUp[]
  leads                           Lead[]
  leadSessions                    LeadSession[]
  leadActivities                  LeadActivity[]
  bookings                        Booking[]
  googleReviewSummary             GoogleReviewSummary?
  settings                        TenantSettings?
  galleryImages                   GalleryImage[]
  socialLinks                     SocialLink[]
  services                        Service[]
  menus                           Menu[]
  kitchenStations                 KitchenStation[]
  diningTables                    DiningTable[]
  diningCarts                     DiningCart[]
  diningSessions                  DiningSession[]
  diningOrderRounds               DiningOrderRound[]
  diningOrders                    DiningOrder[]
  diningOrderItems                DiningOrderItem[]
  diningOrderLocks                DiningOrderLock[]
  diningOrderLockEvents           DiningOrderLockEvent[]
  diningOrderModificationRequests DiningOrderModificationRequest[]
  diningOrderItemAdjustments      DiningOrderItemAdjustment[]
  diningTableGroups               DiningTableGroup[]
  diningTableGroupMembers         DiningTableGroupMember[]
  diningTableMergeRequests        DiningTableMergeRequest[]
  hostels                         Hostel[]
  hostelRooms                     Room[]
  hostelStudents                  Student[]
  hostelStaffAssignments          HostelStaffAssignment[]
  hostelRoomAllocations           RoomAllocation[]
  payments                        Payment[]
  paymentReceipts                 PaymentReceipt[]
  hostelFees                      HostelFee[]
  hostelFeeAssignments            HostelFeeAssignment[]
  hostelInvoices                  HostelInvoice[]
  hostelInvoicePayments           HostelInvoicePayment[]

  @@index([createdAt])
}

enum HostelFeeType {
  MONTHLY
  ADMISSION
  SECURITY_DEPOSIT
  MESS
  ELECTRICITY
  MAINTENANCE
  OTHER
}

enum HostelFeeAssignmentStatus {
  ACTIVE
  WAIVED
  CANCELLED
}

enum HostelInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum HostelStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum RoomSharingType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  DORMITORY
}

enum RoomVacancyStatus {
  VACANT
  PARTIALLY_OCCUPIED
  FULL
  UNAVAILABLE
}

enum RoomAllocationAction {
  ALLOCATED
  DEALLOCATED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  ARCHIVED
}

enum StudentPaymentStatus {
  PAID
  PARTIAL
  DUE
  OVERDUE
}

enum HostelStaffRole {
  ADMIN
  STAFF
}

enum PaymentMethod {
  UPI
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUBMITTED
  VERIFYING
  PAID
  FAILED
  REJECTED
  REFUNDED
}

model Hostel {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  status    HostelStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms            Room[]
  students         Student[]
  staffAssignments HostelStaffAssignment[]
  allocations      RoomAllocation[]
  fees             HostelFee[]
  feeAssignments   HostelFeeAssignment[]
  invoices         HostelInvoice[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("HostelProperty")
}

model Room {
  id            String            @id @default(uuid())
  tenantId      String
  hostelId      String
  roomNumber    String
  capacity      Int
  occupancy     Int               @default(0)
  sharingType   RoomSharingType   @default(SINGLE)
  vacancyStatus RoomVacancyStatus @default(VACANT)
  status        RoomStatus        @default(AVAILABLE)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel            Hostel           @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  students          Student[]
  allocationHistory RoomAllocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, hostelId, roomNumber])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, status])
  @@index([tenantId, hostelId, vacancyStatus])
}

model RoomAllocation {
  id         String               @id @default(uuid())
  tenantId   String
  hostelId   String
  roomId     String
  studentId  String
  action     RoomAllocationAction
  actorId    String?
  happenedAt DateTime             @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel  Hostel  @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  room    Room    @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, roomId, happenedAt])
  @@index([tenantId, studentId, happenedAt])
}

model Student {
  id                String               @id @default(uuid())
  tenantId          String
  hostelId          String
  roomId            String?
  userId            String?
  admissionNumber   String
  name              String
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  admissionDate     DateTime             @default(now())
  paymentStatus     StudentPaymentStatus @default(DUE)
  status            StudentStatus        @default(ACTIVE)
  outstandingAmount Decimal              @default(0) @db.Decimal(12, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel            Hostel                @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  room              Room?                 @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user              TenantUser?           @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  allocationHistory RoomAllocation[]
  payments          Payment[]
  feeAssignments    HostelFeeAssignment[]
  invoices          HostelInvoice[]

  @@unique([tenantId, admissionNumber])
  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, roomId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, paymentStatus])
}

model HostelStaffAssignment {
  id        String          @id @default(uuid())
  tenantId  String
  hostelId  String
  userId    String
  role      HostelStaffRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   TenantUser @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  hostel Hostel     @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, hostelId, userId])
  @@index([tenantId, hostelId, role])
}

model HostelFee {
  id          String        @id @default(uuid())
  tenantId    String
  hostelId    String
  name        String
  type        HostelFeeType
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel      Hostel                @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignments HostelFeeAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, hostelId, name])
  @@index([tenantId, hostelId, isActive])
  @@index([tenantId, type])
}

model HostelFeeAssignment {
  id          String                    @id @default(uuid())
  tenantId    String
  hostelId    String
  studentId   String
  feeId       String
  amount      Decimal                   @db.Decimal(12, 2)
  assignedAt  DateTime                  @default(now())
  dueDate     DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  status      HostelFeeAssignmentStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel       Hostel              @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student      Student             @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  fee          HostelFee           @relation(fields: [feeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  invoiceItems HostelInvoiceItem[]

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, feeId])
  @@index([tenantId, dueDate])
}

model HostelInvoice {
  id            String              @id @default(uuid())
  tenantId      String
  hostelId      String
  studentId     String
  invoiceNumber String
  issueDate     DateTime            @default(now())
  dueDate       DateTime?
  subtotal      Decimal             @db.Decimal(12, 2)
  discount      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal             @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal             @default(0) @db.Decimal(12, 2)
  status        HostelInvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel   Hostel                 @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student  Student                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  items    HostelInvoiceItem[]
  payments HostelInvoicePayment[]

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, hostelId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
}

model HostelInvoiceItem {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String
  feeAssignmentId String?
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice       HostelInvoice        @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  feeAssignment HostelFeeAssignment? @relation(fields: [feeAssignmentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, feeAssignmentId])
}

model HostelInvoicePayment {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  paymentId   String
  amount      Decimal  @db.Decimal(12, 2)
  allocatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice HostelInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  payment Payment       @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceId, paymentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentId])
}

model Payment {
  id                     String        @id @default(uuid())
  tenantId               String
  studentId              String
  amount                 Decimal       @db.Decimal(12, 2)
  currency               String        @default("INR")
  method                 PaymentMethod @default(UPI)
  upiVpa                 String?
  utr                    String?
  transactionReferenceId String?
  status                 PaymentStatus @default(INITIATED)
  receiptId              String?
  proofUrl               String?
  initiatedAt            DateTime      @default(now())
  submittedAt            DateTime?
  verifiedAt             DateTime?
  verifiedBy             String?
  rejectedReason         String?
  metadata               Json?
  submitIdempotencyKey   String?
  verifyIdempotencyKey   String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  receipt            PaymentReceipt?
  invoiceAllocations HostelInvoicePayment[]

  @@unique([tenantId, studentId, submitIdempotencyKey])
  @@unique([tenantId, studentId, verifyIdempotencyKey])
  @@unique([id, tenantId])
  @@index([tenantId, studentId, status, createdAt])
  @@index([tenantId, utr])
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  tenantId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, issuedAt])
}

model TenantUser {
  id                     String                  @id @default(uuid())
  tenantId               String
  name                   String
  email                  String
  passwordHash           String
  role                   String                  @default("owner")
  teamId                 String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedLeads          Lead[]                  @relation("LeadAssignee")
  hostelStaffAssignments HostelStaffAssignment[]
  hostelStudents         Student[]

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Lead {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  email       String?
  phone       String
  source      String         @default("ORGANIC")
  campaignId  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  location    String?
  status      String         @default("NEW")
  notes       String?
  assignedTo  String?
  teamId      String?
  convertedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  followUps   FollowUp[]
  feedbacks   Feedback[]
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  assignee    TenantUser?    @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  sessions    LeadSession[]
  activities  LeadActivity[]
  bookings    Booking[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, deletedAt])
}

model LeadSession {
  id             String    @id @default(uuid())
  tenantId       String
  leadId         String
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  source         String?
  campaignId     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deletedAt      DateTime?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activities LeadActivity[]

  @@index([tenantId, leadId, startedAt])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, deletedAt])
}

model LeadActivity {
  id         String    @id @default(uuid())
  tenantId   String
  leadId     String
  sessionId  String
  type       String
  timestamp  DateTime  @default(now())
  archivedAt DateTime?
  metadata   Json?

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session LeadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([tenantId, archivedAt])
  @@index([leadId, timestamp])
  @@index([sessionId, timestamp])
}

model Booking {
  id               String    @id @default(uuid())
  tenantId         String
  leadId           String
  bookingDate      DateTime?
  selectedServices Json?
  selectedTime     String?
  status           String    @default("PENDING")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model GoogleReviewSummary {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  rating            Float?
  totalReviewsCount Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Feedback {
  id         String   @id @default(uuid())
  tenantId   String
  leadId     String
  comment    String
  type       String   @default("NEUTRAL")
  rating     Int?
  status     String   @default("PENDING")
  approvedBy String?
  createdBy  String   @default("customer")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lead       Lead     @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model FollowUp {
  id         String    @id @default(uuid())
  note       String
  followUpAt DateTime?
  tenantId   String
  leadId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lead       Lead      @relation(fields: [leadId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model TenantSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  logoUrl          String?
  bannerUrl        String?
  logoShape        String   @default("circle")
  primaryColor     String   @default("#000000")
  secondaryColor   String   @default("#FFFFFF")
  sectionOrder     Json?    @default("[\"hero\", \"services\", \"gallery\"]")
  businessPhone    String?
  businessWhatsApp String?
  tagline          String?
  openHour         Int?
  closeHour        Int?
  availableHours   Json?
  upiVpa           String?
  upiPayeeName     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  category  String
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId])
  @@index([tenantId, category])
}

model SocialLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform])
  @@index([tenantId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  icon        String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Menu {
  id          String    @id @default(uuid())
  tenantId    String
  locationId  String
  name        String
  description String?
  status      String    @default("ACTIVE")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  version     Int       @default(0)
  deletedAt   DateTime?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, locationId, status])
  @@index([tenantId, locationId, sortOrder])
}

model MenuCategory {
  id          String    @id @default(uuid())
  tenantId    String
  locationId  String
  menuId      String
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  version     Int       @default(0)
  deletedAt   DateTime?

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([menuId])
  @@index([menuId, sortOrder])
}

model MenuItem {
  id               String    @id @default(uuid())
  tenantId         String
  locationId       String
  categoryId       String
  name             String
  description      String?
  shortDescription String?
  image            String?
  basePrice        Float?
  itemType         String    @default("STANDARD")
  kitchenStationId String?
  status           String    @default("ACTIVE")
  availability     String    @default("AVAILABLE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  version          Int       @default(0)
  deletedAt        DateTime?

  category          MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kitchenStation    KitchenStation?   @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  variants          ItemVariant[]
  addons            ItemAddon[]
  modifiers         ItemModifier[]
  prices            ItemPrice[]
  availabilityState ItemAvailability?
  images            MenuItemImage[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, locationId, categoryId])
  @@index([tenantId, locationId, status])
  @@index([tenantId, locationId, availability])
}

model ItemVariant {
  id              String    @id @default(uuid())
  tenantId        String
  locationId      String
  itemId          String
  name            String
  priceAdjustment Float?
  sku             String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  version         Int       @default(0)
  deletedAt       DateTime?

  item   MenuItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  prices ItemPrice[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([itemId])
}

model ItemAddon {
  id          String    @id @default(uuid())
  tenantId    String
  locationId  String
  itemId      String
  name        String
  price       Float?
  maxQuantity Int?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  version     Int       @default(0)
  deletedAt   DateTime?

