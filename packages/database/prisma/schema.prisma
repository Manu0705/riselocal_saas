generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  domain    String?    @unique
  theme     String     @default("default")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     TenantUser[]
  feedbacks Feedback[]
  followUps FollowUp[]
  leads     Lead[]
  leadSessions LeadSession[]
  leadActivities LeadActivity[]
  bookings Booking[]
  googleReviewSummary GoogleReviewSummary?
  settings  TenantSettings?
  galleryImages GalleryImage[]
  socialLinks SocialLink[]
  services  Service[]

  @@index([createdAt])
}

model TenantUser {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         String   @default("owner")
  teamId       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]  @relation("LeadAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Lead {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String
  source    String     @default("ORGANIC")
  campaignId String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  location  String?
  status    String     @default("NEW")
  notes     String?
  assignedTo String?
  teamId    String?
  convertedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  followUps FollowUp[]
  feedbacks Feedback[]
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  assignee  TenantUser? @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  sessions  LeadSession[]
  activities LeadActivity[]
  bookings Booking[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, deletedAt])
  @@unique([tenantId, phone])
}

model LeadSession {
  id             String   @id @default(uuid())
  tenantId       String
  leadId         String
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  source         String?
  campaignId     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deletedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activities LeadActivity[]

  @@index([tenantId, leadId, startedAt])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, deletedAt])
}

model LeadActivity {
  id         String   @id @default(uuid())
  tenantId   String
  leadId     String
  sessionId  String
  type       String
  timestamp  DateTime @default(now())
  archivedAt DateTime?
  metadata   Json?

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session LeadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([tenantId, archivedAt])
  @@index([leadId, timestamp])
  @@index([sessionId, timestamp])
}

model Booking {
  id               String   @id @default(uuid())
  tenantId         String
  leadId           String
  bookingDate      DateTime?
  selectedServices Json?
  selectedTime     String?
  status           String   @default("PENDING")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@unique([tenantId, leadId])
}

model GoogleReviewSummary {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  rating            Float?
  totalReviewsCount Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Feedback {
  id         String   @id @default(uuid())
  tenantId   String
  leadId     String
  comment    String
  type       String   @default("NEUTRAL")
  rating     Int?
  status     String   @default("PENDING")
  approvedBy String?
  createdBy  String   @default("customer")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lead       Lead     @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model FollowUp {
  id         String    @id @default(uuid())
  note       String
  followUpAt DateTime?
  tenantId   String
  leadId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lead       Lead      @relation(fields: [leadId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model TenantSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  logoUrl         String?
  bannerUrl       String?
  logoShape       String   @default("circle")
  primaryColor    String   @default("#000000")
  secondaryColor  String   @default("#FFFFFF")
  sectionOrder    Json?    @default("[\"hero\", \"services\", \"gallery\"]")
  businessPhone   String?
  businessWhatsApp String?
  tagline         String?
  openHour        Int?
  closeHour       Int?
  availableHours  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  category  String
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, category])
  @@unique([tenantId, url])
}

model SocialLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, platform])
}

model Service {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  description String?
  icon      String?
  position  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
