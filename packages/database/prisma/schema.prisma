generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                              String                           @id @default(uuid())
  name                            String
  slug                            String                           @unique
  domain                          String?                          @unique
  theme                           String                           @default("default")
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  bookings                        Booking[]
  diningCarts                     DiningCart[]
  diningOrders                    DiningOrder[]
  diningOrderItems                DiningOrderItem[]
  diningOrderItemAdjustments      DiningOrderItemAdjustment[]
  diningOrderLocks                DiningOrderLock[]
  diningOrderLockEvents           DiningOrderLockEvent[]
  diningOrderModificationRequests DiningOrderModificationRequest[]
  diningOrderRounds               DiningOrderRound[]
  diningSessions                  DiningSession[]
  diningTables                    DiningTable[]
  diningTableGroups               DiningTableGroup[]
  diningTableGroupMembers         DiningTableGroupMember[]
  diningTableMergeRequests        DiningTableMergeRequest[]
  feedbacks                       Feedback[]
  followUps                       FollowUp[]
  galleryImages                   GalleryImage[]
  googleReviewSummary             GoogleReviewSummary?
  hostelAnnouncements             HostelAnnouncement[]
  hostelComplaints                HostelComplaint[]
  hostelDeposits                  HostelDeposit[]
  hostelFees                      HostelFee[]
  hostelFeeAssignments            HostelFeeAssignment[]
  hostelInvoices                  HostelInvoice[]
  hostelInvoicePayments           HostelInvoicePayment[]
  hostelLedgerEntries             HostelLedgerEntry[]
  hostels                         Hostel[]
  hostelStaffAssignments          HostelStaffAssignment[]
  kitchenStations                 KitchenStation[]
  leads                           Lead[]
  leadActivities                  LeadActivity[]
  leadSessions                    LeadSession[]
  menus                           Menu[]
  payments                        Payment[]
  paymentReceipts                 PaymentReceipt[]
  hostelRooms                     Room[]
  hostelRoomAllocations           RoomAllocation[]
  services                        Service[]
  socialLinks                     SocialLink[]
  hostelStudents                  Student[]
  settings                        TenantSettings?
  users                           TenantUser[]

  @@index([createdAt])
}

model Hostel {
  id               String                  @id @default(uuid())
  tenantId         String
  name             String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  status           HostelStatus            @default(ACTIVE)
  announcements    HostelAnnouncement[]
  complaints       HostelComplaint[]
  deposits         HostelDeposit[]
  fees             HostelFee[]
  feeAssignments   HostelFeeAssignment[]
  invoices         HostelInvoice[]
  ledgerEntries    HostelLedgerEntry[]
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffAssignments HostelStaffAssignment[]
  rooms            Room[]
  allocations      RoomAllocation[]
  students         Student[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("HostelProperty")
}

model Room {
  id                String            @id @default(uuid())
  tenantId          String
  hostelId          String
  roomNumber        String
  capacity          Int
  status            RoomStatus        @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  occupancy         Int               @default(0)
  sharingType       RoomSharingType   @default(SINGLE)
  vacancyStatus     RoomVacancyStatus @default(VACANT)
  isActive          Boolean           @default(true)
  hostel            Hostel            @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocationHistory RoomAllocation[]
  students          Student[]

  @@unique([id, tenantId])
  @@unique([tenantId, hostelId, roomNumber])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, status])
  @@index([tenantId, hostelId, vacancyStatus])
}

model RoomAllocation {
  id         String               @id @default(uuid())
  tenantId   String
  hostelId   String
  roomId     String
  studentId  String
  action     RoomAllocationAction
  actorId    String?
  happenedAt DateTime             @default(now())
  hostel     Hostel               @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  room       Room                 @relation(fields: [roomId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student    Student              @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId, happenedAt])
  @@index([tenantId, studentId, happenedAt])
}

model Student {
  id                String                @id @default(uuid())
  tenantId          String
  hostelId          String
  roomId            String?
  admissionNumber   String
  name              String
  email             String?
  phone             String?
  status            StudentStatus         @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  userId            String?
  dateOfBirth       DateTime?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  admissionDate     DateTime              @default(now())
  paymentStatus     StudentPaymentStatus  @default(DUE)
  outstandingAmount Decimal               @default(0) @db.Decimal(12, 2)
  complaints        HostelComplaint[]
  feeAssignments    HostelFeeAssignment[]
  invoices          HostelInvoice[]
  payments          Payment[]
  allocationHistory RoomAllocation[]
  hostel            Hostel                @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  room              Room?                 @relation(fields: [roomId, tenantId], references: [id, tenantId])
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              TenantUser?           @relation(fields: [userId, tenantId], references: [id, tenantId])

  @@unique([tenantId, admissionNumber])
  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, roomId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, paymentStatus])
}

model HostelStaffAssignment {
  id        String          @id @default(uuid())
  tenantId  String
  hostelId  String
  userId    String
  role      HostelStaffRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  hostel    Hostel          @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      TenantUser      @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, hostelId, userId])
  @@index([tenantId, hostelId, role])
}

model HostelFee {
  id          String                @id @default(uuid())
  tenantId    String
  hostelId    String
  name        String
  type        HostelFeeType
  description String?
  amount      Decimal               @db.Decimal(12, 2)
  currency    String                @default("INR")
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  hostel      Hostel                @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments HostelFeeAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, hostelId, name])
  @@index([tenantId, hostelId, isActive])
  @@index([tenantId, type])
}

model HostelFeeAssignment {
  id           String                    @id @default(uuid())
  tenantId     String
  hostelId     String
  studentId    String
  feeId        String
  amount       Decimal                   @db.Decimal(12, 2)
  assignedAt   DateTime                  @default(now())
  dueDate      DateTime?
  periodStart  DateTime?
  periodEnd    DateTime?
  status       HostelFeeAssignmentStatus @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  fee          HostelFee                 @relation(fields: [feeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  hostel       Hostel                    @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student      Student                   @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems HostelInvoiceItem[]

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, feeId])
  @@index([tenantId, dueDate])
}

model HostelInvoice {
  id            String                 @id @default(uuid())
  tenantId      String
  hostelId      String
  studentId     String
  invoiceNumber String
  issueDate     DateTime               @default(now())
  dueDate       DateTime?
  subtotal      Decimal                @db.Decimal(12, 2)
  discount      Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal                @db.Decimal(12, 2)
  paidAmount    Decimal                @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal                @default(0) @db.Decimal(12, 2)
  status        HostelInvoiceStatus    @default(DRAFT)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  hostel        Hostel                 @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student       Student                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         HostelInvoiceItem[]
  payments      HostelInvoicePayment[]

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, hostelId, studentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
}

model HostelInvoiceItem {
  id              String               @id @default(uuid())
  tenantId        String
  invoiceId       String
  feeAssignmentId String?
  description     String
  amount          Decimal              @db.Decimal(12, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  feeAssignment   HostelFeeAssignment? @relation(fields: [feeAssignmentId, tenantId], references: [id, tenantId])
  invoice         HostelInvoice        @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, feeAssignmentId])
}

model HostelInvoicePayment {
  id          String        @id @default(uuid())
  tenantId    String
  invoiceId   String
  paymentId   String
  amount      Decimal       @db.Decimal(12, 2)
  allocatedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoice     HostelInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  payment     Payment       @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceId, paymentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentId])
}

model Payment {
  id                     String                 @id @default(uuid())
  tenantId               String
  studentId              String
  amount                 Decimal                @db.Decimal(12, 2)
  currency               String                 @default("INR")
  method                 PaymentMethod          @default(UPI)
  upiVpa                 String?
  utr                    String?
  transactionReferenceId String?
  status                 PaymentStatus          @default(INITIATED)
  receiptId              String?
  proofUrl               String?
  initiatedAt            DateTime               @default(now())
  submittedAt            DateTime?
  verifiedAt             DateTime?
  verifiedBy             String?
  rejectedReason         String?
  metadata               Json?
  submitIdempotencyKey   String?
  verifyIdempotencyKey   String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  invoiceAllocations     HostelInvoicePayment[]
  student                Student                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt                PaymentReceipt?

  @@unique([tenantId, studentId, submitIdempotencyKey])
  @@unique([tenantId, studentId, verifyIdempotencyKey])
  @@unique([id, tenantId])
  @@index([tenantId, studentId, status, createdAt])
  @@index([tenantId, utr])
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  tenantId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, issuedAt])
}

model HostelDeposit {
  id              String              @id @default(uuid())
  tenantId        String
  hostelId        String
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR")
  depositDate     DateTime            @default(now())
  referenceNumber String?
  paymentMethod   PaymentMethod       @default(UPI)
  status          HostelDepositStatus @default(PENDING)
  depositedBy     String?
  reconciledAt    DateTime?
  reconciledBy    String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  hostel          Hostel              @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, hostelId, depositDate])
  @@index([tenantId, referenceNumber])
}

model HostelLedgerEntry {
  id            String                @id @default(uuid())
  tenantId      String
  hostelId      String
  entryDate     DateTime              @default(now())
  type          HostelLedgerEntryType
  direction     HostelLedgerDirection
  amount        Decimal               @db.Decimal(12, 2)
  currency      String                @default("INR")
  referenceType String?
  referenceId   String?
  description   String
  createdBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  hostel        Hostel                @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, entryDate])
  @@index([tenantId, hostelId, type])
  @@index([tenantId, hostelId, direction])
  @@index([tenantId, referenceType, referenceId])
}

model HostelComplaint {
  id          String                  @id @default(uuid())
  tenantId    String
  hostelId    String
  studentId   String?
  subject     String
  description String
  priority    HostelComplaintPriority @default(MEDIUM)
  status      HostelComplaintStatus   @default(OPEN)
  assignedTo  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  hostel      Hostel                  @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student     Student?                @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: SetNull)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, hostelId, priority])
  @@index([tenantId, hostelId, createdAt])
  @@index([tenantId, studentId])
  @@index([tenantId, assignedTo])
}

model HostelAnnouncement {
  id        String                     @id @default(uuid())
  tenantId  String
  hostelId  String
  title     String
  message   String
  audience  HostelAnnouncementAudience @default(ALL)
  publishAt DateTime?
  expiresAt DateTime?
  status    HostelAnnouncementStatus   @default(DRAFT)
  createdBy String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  hostel    Hostel                     @relation(fields: [hostelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, hostelId, status])
  @@index([tenantId, hostelId, audience])
  @@index([tenantId, hostelId, publishAt])
  @@index([tenantId, hostelId, expiresAt])
}

model TenantUser {
  id                     String                  @id @default(uuid())
  tenantId               String
  name                   String
  email                  String
  passwordHash           String
  role                   String                  @default("owner")
  teamId                 String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  hostelStaffAssignments HostelStaffAssignment[]
  assignedLeads          Lead[]                  @relation("LeadAssignee")
  hostelStudents         Student?
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Lead {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  email       String?
  phone       String
  source      String         @default("ORGANIC")
  campaignId  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  location    String?
  status      String         @default("NEW")
  notes       String?
  assignedTo  String?
  teamId      String?
  convertedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  bookings    Booking[]
  feedbacks   Feedback[]
  followUps   FollowUp[]
  assignee    TenantUser?    @relation("LeadAssignee", fields: [assignedTo], references: [id])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  activities  LeadActivity[]
  sessions    LeadSession[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, deletedAt])
}

model LeadSession {
  id             String         @id @default(uuid())
  tenantId       String
  leadId         String
  startedAt      DateTime       @default(now())
  lastActivityAt DateTime       @default(now())
  source         String?
  campaignId     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deletedAt      DateTime?
  activities     LeadActivity[]
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, startedAt])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, deletedAt])
}

model LeadActivity {
  id         String      @id @default(uuid())
  tenantId   String
  leadId     String
  sessionId  String
  type       String
  timestamp  DateTime    @default(now())
  archivedAt DateTime?
  metadata   Json?
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session    LeadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([tenantId, archivedAt])
  @@index([leadId, timestamp])
  @@index([sessionId, timestamp])
}

model Booking {
  id               String    @id @default(uuid())
  tenantId         String
  leadId           String
  bookingDate      DateTime?
  selectedServices Json?
  selectedTime     String?
  status           String    @default("PENDING")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model GoogleReviewSummary {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  rating            Float?
  totalReviewsCount Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Feedback {
  id         String   @id @default(uuid())
  tenantId   String
  leadId     String
  comment    String
  type       String   @default("NEUTRAL")
  rating     Int?
  status     String   @default("PENDING")
  approvedBy String?
  createdBy  String   @default("customer")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model FollowUp {
  id         String    @id @default(uuid())
  note       String
  followUpAt DateTime?
  tenantId   String
  leadId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lead       Lead      @relation(fields: [leadId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model TenantSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  logoUrl          String?
  bannerUrl        String?
  logoShape        String   @default("circle")
  primaryColor     String   @default("#000000")
  secondaryColor   String   @default("#FFFFFF")
  sectionOrder     Json?    @default("[\"hero\", \"services\", \"gallery\"]")
  businessPhone    String?
  businessWhatsApp String?
  tagline          String?
  openHour         Int?
  closeHour        Int?
  availableHours   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  upiVpa           String?
  upiPayeeName     String?
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  category  String
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId])
  @@index([tenantId, category])
}

model SocialLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform])
  @@index([tenantId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  icon        String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Menu {
  id          String         @id @default(uuid())
  tenantId    String
  locationId  String
  name        String
  description String?
  status      String         @default("ACTIVE")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  version     Int            @default(0)
  deletedAt   DateTime?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories  MenuCategory[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, locationId, status])
  @@index([tenantId, locationId, sortOrder])
}

model MenuCategory {
  id          String     @id @default(uuid())
  tenantId    String
  locationId  String
  menuId      String
  name        String
  description String?
  image       String?
  sortOrder   Int        @default(0)
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
