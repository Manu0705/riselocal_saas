{
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^10.0.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@saas/database": "workspace:*",
    "@saas/domain-core": "workspace:*",
    "cloudinary": "^1.40.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "2.0.2"
  },
  "scripts": {
    "dev": "pnpm run dev:all",
    "qa": "pnpm run qa:api",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:admin": "pnpm run build:packages && pnpm --filter @saas/admin build",
    "start": "pnpm run start:web",
    "dev:web": "pnpm --filter @saas/web dev",
    "dev:all": "concurrently \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "build:web": "pnpm --filter @saas/web build",
    "start:web": "node scripts/run-with-env.cjs production pnpm --filter @saas/web start",
    "dev:api": "node scripts/run-with-env.cjs development ts-node-dev --respawn --transpile-only --project apps/api/tsconfig.json apps/api/src/server.ts",
    "qa:api": "node scripts/run-with-env.cjs qa ts-node-dev --respawn --transpile-only --project apps/api/tsconfig.json apps/api/src/server.ts",
    "build:packages": "pnpm --filter @saas/domain-core run build && pnpm --filter @saas/database run build",
    "build:api": "pnpm run build:packages && tsc -p apps/api/tsconfig.json",
    "start:api": "node apps/api/dist/server.js",
    "db:generate": "node scripts/prisma-generate.cjs",
    "db:deploy": "pnpm --filter @saas/database exec prisma migrate deploy",
    "db:status": "pnpm --filter @saas/database exec prisma migrate status",
    "db:sync-check": "bash scripts/db-sync-check.sh",
    "db:validate": "pnpm --filter @saas/database exec prisma validate",
    "test:contracts": "pnpm --filter @saas/domain-core run build && pnpm --filter @saas/domain-core run test:contracts",
    "test:dining": "pnpm run build:api && node --test tests/dining/**/*.test.cjs",
    "test:hostel": "pnpm run build:api && node --test tests/hostel/**/*.test.cjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
 "prisma": {
  "schema": "packages/database/prisma/schema.prisma",
  "seed": "ts-node packages/database/prisma/seed.ts"
},
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
